# Where the servers docker-compose.yml starts are, in the variables the tests read: one line
# per compose service. A test whose variable is unset skips, so `cargo test` also works with
# no server running.
#
# Locally, after `docker compose up -d --wait`:
#   set -a; . ./test-servers.env; set +a; cargo test --workspace
# CI appends the same lines to $GITHUB_ENV on Linux (.github/workflows/ci.yml).
DBDESK_TEST_POSTGRES_URL=postgres://dbdesk:dbdesk@localhost:55432/dbdesk
DBDESK_TEST_POSTGRES_TLS_URL=postgres://dbdesk:dbdesk@localhost:55443/dbdesk
DBDESK_TEST_MYSQL_URL=mysql://dbdesk:dbdesk@localhost:55306/dbdesk
DBDESK_TEST_MARIADB_URL=mysql://dbdesk:dbdesk@localhost:55307/dbdesk
DBDESK_TEST_SQLSERVER_URL=sqlserver://sa:Dbdesk-Test-2026@localhost:51433/dbdesk
DBDESK_TEST_CLICKHOUSE_URL=clickhouse://dbdesk:dbdesk@localhost:58123/dbdesk
DBDESK_TEST_CLICKHOUSE_TLS_URL=clickhouse://dbdesk:dbdesk@localhost:58443/dbdesk
# The SSH server, and the PostgreSQL service as that server reaches it on the compose network.
DBDESK_TEST_SSH_URL=ssh://dbdesk:dbdesk@localhost:55222
DBDESK_TEST_SSH_POSTGRES_URL=postgres://dbdesk:dbdesk@postgres:5432/dbdesk
